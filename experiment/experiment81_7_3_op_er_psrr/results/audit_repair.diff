+def _ensure_darg_compatibility(preflight):
+    import subprocess
+
+    extractor = EXP / ".runtime/convert_darg_metrics.py"
+    records_path = EXP / ".runtime/darg_best_compat.json"
+    if not extractor.is_file():
+        raise FileNotFoundError(f"DARG audit compatibility extractor is missing: {extractor}")
+    if not records_path.is_file():
+        subprocess.run([sys.executable, str(extractor)], cwd=EXP, check=True)
+    records = json.loads(records_path.read_text(encoding="utf-8"))
+    if set(records) != {str(fold) for fold in range(1, 11)}:
+        raise RuntimeError("DARG compatibility export does not contain ten folds")
+    for fold in range(1, 11):
+        record = records[str(fold)]
+        checkpoint = HIST_E744 / ".runtime/checkpoints" / f"{E74_GROUP}_f{fold:02d}.best.pt"
+        expected_sha = preflight["source_files"].get(str(checkpoint.resolve()))
+        if (record.get("group"), record.get("fold"), record.get("checkpoint_sha256")) != (
+                E74_GROUP, fold, expected_sha):
+            raise RuntimeError(f"DARG compatibility export identity mismatch at fold {fold}")
+        if record.get("prior_independent_audit_status") != "INDEPENDENT_AUDIT_PASS":
+            raise RuntimeError(f"DARG compatibility export lacks historical independent audit at fold {fold}")
+    return records
+
+
+def _shared_initial_parameters_equal(left, right):
+    import torch
+
+    group_only = ("spgs_mlp.", "reliability_net.")
+    left_state = {key: value for key, value in left.state_dict().items()
+                  if key != "prompt_features" and not key.startswith(group_only)}
+    right_state = {key: value for key, value in right.state_dict().items()
+                   if key != "prompt_features" and not key.startswith(group_only)}
+    return left_state.keys() == right_state.keys() and all(
+        torch.equal(left_state[key], right_state[key]) for key in left_state
+    )
+
