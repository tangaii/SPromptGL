    "gate_init": 0.0075,
    "gate_max": 0.05,
    "new_parameters_weight_decay": 0,
    "branch_seed": "400000+fold",
    "calibration": "same per-patient norm mechanism in every group, including E5/E9; maximum 5%; empty selection exactly zero"
