{
  "experiment": "Experiment 1 — Modality-Aware Semantic Prompt Enhancement (MASPE)",
  "dataset": "ABIDE",
  "data_root": "/data/adodas/SPromptGL-main/data/ABIDE",
  "modalities": ["PHENO", "ANAT", "FUNC", "Correlation"],
  "class_map": {"DX_GROUP_1_ASD": 0, "DX_GROUP_2_NC": 1},
  "configs": ["P0", "P1", "P2", "P3"],
  "seeds": [0, 1, 2],
  "outer_cv": {"type": "StratifiedKFold", "n_splits": 10, "shuffle": true, "random_state": "seed"},
  "inner_validation": {"type": "StratifiedShuffleSplit", "test_size": 0.1, "random_state": "seed + 1000 + fold_id"},
  "training": {
    "GC_mode": "weighted-cosine",
    "MF_mode": "concat",
    "MP_mode": "GCN",
    "mode": "simple-2",
    "dropout": 0.35,
    "lr": 0.0038,
    "n_head": 2,
    "n_hidden": 18,
    "nlayer": 1,
    "reg": 0.11,
    "nepoch": 450,
    "early_stopping_patience": 200,
    "validation_metric": "accuracy",
    "optimizer": "Adam"
  },
  "evaluation": {
    "primary_metrics": ["balanced_accuracy", "probability_roc_auc_asd_positive"],
    "secondary_metrics": ["accuracy", "asd_sensitivity", "nc_specificity", "f1"],
    "decision_rule": "argmax of model probabilities",
    "bootstrap_repetitions": 2000,
    "bootstrap_unit": "participant; each resample is shared across seeds and compared configurations"
  },
  "protocol": {
    "graph_visibility": "transductive all-participant feature propagation; only outer-training inner-training labels enter supervised graph targets and classification loss",
    "preprocessing": "frozen processed_standard_data.csv and modal_feat_dict.npy; global StandardScaler and precomputed RFE provenance are retained and disclosed",
    "no_test_tuning": true
  }
}
