+def _tree_replay_close(left, right):
+    import torch
+    if torch.is_tensor(left) and torch.is_tensor(right):
+        if left.shape != right.shape or left.dtype != right.dtype:
+            return False, "tensor shape/dtype"
+        if left.is_floating_point() or left.is_complex():
+            if torch.allclose(left, right, atol=2e-6, rtol=1e-5):
+                return True, None
+            return False, "tensor values"
+        if torch.equal(left, right):
+            return True, None
+        return False, "integer tensor values"
+    if isinstance(left, dict) and isinstance(right, dict):
+        if left.keys() != right.keys():
+            return False, "dictionary keys"
+        for key in left:
+            equal, where = _tree_replay_close(left[key], right[key])
+            if not equal:
+                return False, f"{key}.{where}" if where else str(key)
+        return True, None
+    if isinstance(left, (tuple, list)) and isinstance(right, type(left)):
+        if len(left) != len(right):
+            return False, "sequence length"
+        for index, (left_item, right_item) in enumerate(zip(left, right)):
+            equal, where = _tree_replay_close(left_item, right_item)
+            if not equal:
+                return False, f"{index}.{where}" if where else str(index)
+        return True, None
+    if isinstance(left, float) and isinstance(right, float):
+        return math.isclose(left, right, abs_tol=1e-7, rel_tol=1e-6), "float" if not math.isclose(
+            left, right, abs_tol=1e-7, rel_tol=1e-6
+        ) else None
+    return (left == right), None if left == right else "value"
+
