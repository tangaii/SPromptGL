      "status": "RUN_FIRST"
    },
    "G2": {
      "name": "PSRR-Unary-Medical",
      "mechanism": "independent local-token Prompt matching without cross-token messages",
      "status": "CONDITIONAL_ON_G1_PASSING_ALL_PRE_REGISTERED_PERFORMANCE_AND_AUDIT_GATES"
    },
    "G3": {
      "name": "PSRR-Full-Scrambled",
